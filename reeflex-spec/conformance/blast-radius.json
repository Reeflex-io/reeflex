        "note": "An EMPTY list is not a small list. Handlers routinely read an empty selection as 'everything', and an agent wanting `single` would otherwise just send an empty array."
      },
      "expect": {
        "blast_radius": "broad"
      },
      "bindings": {
        "wordpress": {
          "ability": "posts/delete",
