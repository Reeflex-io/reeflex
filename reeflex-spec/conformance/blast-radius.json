      "given": {
        "target_shape": "predicate",
        "predicate": "statement with a filter",
        "note": "a WHERE clause narrows a predicate to a smaller predicate; it does not enumerate one. The row count is not in the command text."
      },
      "expect": {
        "blast_radius": "broad"
      },
      "bindings": {
        "claude": {
          "tool": "Bash",
          "tool_input": {
            "command": "psql -c \"DELETE FROM orders WHERE status='old'\""
